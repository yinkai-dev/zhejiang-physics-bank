{
  "name": "zhejiang-physics-bank",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "export": "node scripts/export-bank.mjs",
    "check:data": "node scripts/check-public.mjs",
    "check:math": "node scripts/check-math.mjs",
    "test": "node --test tests/*.test.mjs",
    "build": "npm run check:data && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "mathjax": "3.2.2"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vite": "8.3.7"
  }
}
