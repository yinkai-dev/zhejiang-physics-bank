s/35d70fbe0b2867b707e957b17a73e2b869e89fd395fad071c6d1123c63f2b3a5.png","width":682,"height":567,"width_mm":86.5},{"type":"figure","src":"images/6520874e8f984d04812db2060b03a50a2f444991760dffcd19d6a8c6d1ca3b07.png","width":659,"height":585,"width_mm":83.6},{"type":"text","value":"（3）观察图形及几何关系可得"},{"type":"math","value":"\\theta = 53^{\\circ} - 37^{\\circ} = 16^{\\circ}"},{"type":"text","value":"2分"},{"type":"figure","src":"images/60b77d4c2908672c88ca3d53e3660a26d52738fc94a7e0cfa141b5194ebee4cf.png","width":479,"height":537,"width_mm":60.7},{"type":"text","value":"(4) E 向上时"},{"type":"math","value":"3r=v_{y}t+\\frac{1}{2}\\frac{Ee}{m}t^{2}\\quad t=\\frac{3r}{4v_{0}}"},{"type":"text","value":"可得"},{"type":"math","value":"E=\\frac{8mv_{0}^{2}}{3er}"},{"type":"text","value":"1 分\n当"},{"type":"math","value":"E \\geq \\frac{8mv_0^2}{3er}"},{"type":"text","value":"时，"},{"type":"math","value":"i = ne"},{"type":"text","value":"1分\nE 向下时"},{"type":"math","value":"Ee \\cdot 3r = 0 - \\frac{1}{2} m(5v_{0})^{2}"},{"type":"text","value":"可得"},{"type":"math","value":"E = -\\frac{25mv_{0}^{2}}{6er}"},{"type":"text","value":"1 分\n当"},{"type":"math","value":"E \\leq -\\frac{25mv_0^2}{6er}"},{"type":"text","value":"时，"},{"type":"math","value":"i = 0"},{"type":"math","value":"E = 0"},{"type":"text","value":"时由图可知"},{"type":"math","value":"\\alpha = 53^{\\circ} - 45^{\\circ} = 8^{\\circ}"},{"type":"math","value":"\\eta = 0.99"},{"type":"math","value":"i = \\eta ne = 0.99ne"},{"type":"text","value":" 1 分"},{"type":"figure","src":"images/129a17c25ed4e560476de4b5320e9c4176338239ab089a67eaf85340a3c6e87b.png","width":748,"height":641,"width_mm":94.9},{"type":"figure","src":"images/2ba3149d093be0b71a94d995db981c80d103d49a9b23e5341f03c412e9834e28.png","width":759,"height":455,"width_mm":96.2}]}}]}
