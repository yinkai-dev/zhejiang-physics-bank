288e6b6df2e16225336e57dd14160.png","width":256,"height":244,"width_mm":30.032,"row_group":"zhenhai-zhongxue-moni-2605-q14-row1"},{"type":"text","value":"\n乙\n"},{"type":"figure","src":"images/5f48b0d9a5457df2b14a047b5cbd44d3670dffbfb92db36629830e379d3f7c26.png","width":274,"height":142,"width_mm":32.132,"row_group":"zhenhai-zhongxue-moni-2605-q14-row1"},{"type":"text","value":"\n丙\n(1)小球释放后落在复写纸上会在白纸上留下印迹，如图乙所示。多次实验后，白纸上留下了10个印迹，如果用画圆法确定小球的落点，图中画的三个圆最合理的是 (选填“A”、“B”或“C”);\n(2)某次实验时，小球落地点分布如图丙所示，测得M、P、N与O点距离分别为 "},{"type":"math","value":"x_{1} , x_{2} , x_{3} ,"},{"type":"text","value":" ，若满足关系(用 "},{"type":"math","value":"m_{1} , m_{2} , x_{1} , x_{2} , x_{3}"},{"type":"text","value":" 表示)，则碰撞前后动量守恒；\n(3)一同学在某次实验中记录了碰撞前后小球落点的位置M、P和N，发现M、N点不在 "},{"type":"math","value":"O P"},{"type":"text","value":" 连线上，下列图中落点位置可能正确的是\nA.　B.　C.　D.\n"},{"type":"figure","src":"images/9b051d9f8eee1b2cf3ef5409eaef15d770ba5ec74755b5dedf1193c1ec5f7a52.png","width":815,"height":392,"width_mm":95.767,"row_group":"zhenhai-zhongxue-moni-2605-q14-row2"},{"type":"figure","src":"images/8fc0c00707fea45d01178ed1afd80aa7280e3e3d67670eeda57a34819c1dcc62.png","width":1039,"height":496,"width_mm":122.019,"row_group":"zhenhai-zhongxue-moni-2605-q14-row3"},{"type":"text","value":"\n14-Ⅱ.一块高度为2cm圆柱形透明玻璃砖内有一粒直径很小的不透明球状杂质，小明设计了如下实验测量该杂质与玻璃砖中心轴线的距离。\n（1）用游标卡尺测量该玻璃砖的直径 "},{"type":"math","value":"D ,"},{"type":"text","value":" ，如图甲所示， "},{"type":"math","value":"D ^ { = }"},{"type":"text","value":" cm。\n（2）在水平桌面上固定一张白纸，如图乙所示，以O为圆心作出直径为D的内圆（实线圆）和另一个外圆（虚线辅助圆），过 "},{"type":"math","value":"O"},{"type":"text","value":" 点作相互垂直的直线 "},{"type":"math","value":"a b"},{"type":"text","value":" 和 "},{"type":"math","value":"c d"},{"type":"text","value":" （与内圆交点为 a、b、c、 "},{"type":"math","value":"d )"},{"type":"text","value":"\n（3）在直线 "},{"type":"math","value":"a b"},{"type":"text","value":" 与外圆交点上分别竖直插两枚大头针 "},{"type":"math","value":"\\mathrm { P r }"},{"type":"text","value":" 和 "},{"type":"math","value":"\\mathrm { P } _ { 2 }"},{"type":"text","value":" 。将该玻璃砖置于纸上并与内圆重合，使玻璃砖绕其中轴线旋转（保持其始终与内圆重合），并在 "},{"type":"math","value":"\\mathrm { P } _ { 2 }"},{"type":"text","value":" 右侧沿平行纸面方向观察，直至 "},{"type":"math","value":"\\mathrm { P } _ { 2 }"},{"type":"text","value":" 恰好完全遮挡住杂质的像和 "},{"type":"math","value":"\\mathrm { P r }"},{"type":"text","value":" 的像，此后固定玻璃砖。\n（4）在外圆弧线上适当的位置竖直插一枚大头针 "},{"type":"math","value":"\\mathrm { P } _ { 3 }"},{"type":"text","value":" ，再在适当位置竖直插一枚大头针 "},{"type":"math","value":"\\mathrm { P } _ { 4 }"},{"type":"text","value":" ，使得沿平行纸面方向观察时 "},{"type":"math","value":"\\mathrm { P } _ { 4 }"},{"type":"text","value":" 完全遮挡住 "},{"type":"math","value":"\\mathrm { P } _ { 3 }"},{"type":"text","value":" 和杂质的像。\n（5）记下四枚大头针的位置并撤掉玻璃砖，作直线P3"},{"type":"math","value":"P_{4}"},{"type":"text","value":"与内圆交于 "},{"type":"math","value":"e"},{"type":"text","value":" 点，作出直线 "},{"type":"math","value":"O e"},{"type":"text","value":" ，用量角器测量出图中夹角"},{"type":"math","value":"\\alpha"},{"type":"text","value":"和 "},{"type":"math","value":"\\beta ,"},{"type":"text","value":" 若该玻璃砖的折射率为 "},{"type":"math","value":"\\sqrt { 3 }"},{"type":"math","value":"\\alpha = 6 0 ^ { \\circ }"},{"type":"math","value":"\\beta = 3 0 ^ { \\circ }"},{"type":"text","value":" ，则该杂质与玻璃砖中轴线的距离x= (用直径符号D表示)。\n14-Ⅲ.在现代农业大棚中，光照强度直接影响农作物的生长与品质。例如，草莓等喜光作物在光照不足时生长缓慢，但夏季正午阳光过强又容易导致叶片灼伤、果实早衰。某校物理兴趣小组参观本地生态农场后，尝试利用所学电路知识设计一款简易光强报警器，帮助农户实时监测棚内光照强度。该实验用到的主要器材如下:学生电源、多用电表、数字电压表（0\\~20V）、数字电流表（0\\~20mA）、滑动变阻器R（最大阻值50"},{"type":"math","value":"\\Omega"},{"type":"text","value":"，1.5A）、白炽灯、可调电阻 "},{"type":"math","value":"R_{1} \\left( 0 \\sim 50 \\mathrm{k} \\Omega \\right)"},{"type":"text","value":" ）、发光二极管LED、光敏电阻 "},{"type":"math","value":"R _ { \\mathrm { G } }"},{"type":"text","value":" ，NPN型三极管VT、开关和若干导线等。\n"},{"type":"figure","src":"images/45d51e75d84e6bb43079ed1cbac3ce4ad4d69006c1d1561d24e64417b63c0461.png","width":187,"height":314,"width_mm":21.842,"row_group":"zhenhai-zhongxue-moni-2605-q14-row4"},{"type":"text","value":"\n图1\n"},{"type":"figure","src":"images/7899b68ae4380b25464bac28be933d2dbb6e0e264eb743688d865d2fd3545935.png","width":457,"height":317,"width_mm":53.554,"row_group":"zhenhai-zhongxue-moni-2605-q14-row4"},{"type":"text","value":"\n图2\n"},{"type":"figure","src":"images/2713a4e2f7ac40507bcd2d1261f1f26de3852223347994495ad451eb727e35f3.png","width":226,"height":256,"width_mm":26.462,"row_group":"zhenhai-zhongxue-moni-2605-q14-row4"},{"type":"text","value":"\n第5页/共8页\n"},{"type":"figure","src":"images/20bcb5245cc3f36f7cb7cd03211d63fe6dfa3ef385799d43a94473ff2f6cb4d7.png","width":421,"height":425,"width_mm":49.354,"row_group":"zhenhai-zhongxue-moni-2605-q14-row4"},{"type":"text","value":"\n图3\n(1) 判断发光二极管的极性。\n"},{"type":"figure","src":"images/58c448dc429dddfda455650f191901c12f323266417b47fbd2c7227bf79b45dc.png","width":562,"height":355,"width_mm":72.539,"row_group":"zhenhai-zhongxue-moni-2605-q14-row5"},{"type":"figure","src":"images/07546c0d7ea56192424d0541a4db91979164b901abde8a76305c8683be8a02a1.png","width":311,"height":254,"width_mm":36.543,"row_group":"zhenhai-zhongxue-moni-2605-q14-row5"},{"type":"text","value":"\n图5\n使用多用电表的 "},{"type":"math","value":"\\text{\" } \\times 10 K \\text{\" }"},{"type":"text","value":" 欧姆挡测量二极管的电阻。如图1所示，当黑表笔与接线端M接触、红表笔与接线端N接触时，多用电表指针位于表盘中b位置（见图2）；对调红、黑表笔后指针位于表盘中a位置（见图2)，由此判断M端为二极管的 (填“正极”或“负极”)。\n(2)研究光敏电阻在不同光照条件下的伏安特性。\n①请根据图3电路图完成实物图连线\n②图4为不同光照强度下得到的光敏电阻伏安特性的3条曲线图，图中曲线I、Ⅱ和对应光敏电阻受到的光照由弱到强。由图像可知，光敏电阻的阻值随其表面受到光照的增强而 (填“增大”或“减小”)。\n(3)组装光强报警器电路并测试其功能。\n图5为利用光敏电阻、发光二极管、三极管（当b、c间电压达到一定程度后，三极管被导通）等元件设计的电路。组装好光强报警器后，在测试过程中发现，当照射到光敏电阻表面的光强未达到报警值时，发光二极管就开始发光，为使报警器正常工作，应 （填“增大”或“减小”）可调电阻 "},{"type":"math","value":"R _ { 1 }"},{"type":"text","value":" 的阻值。"}],"choices":[],"answer":{"status":"source","key":null,"body":[{"type":"text","value":"14-I．（1）B。（2）"},{"type":"math","value":"m_1x_2=m_1x_1+m_2x_3"},{"type":"text","value":"。（3）B。"},{"type":"text","value":"\n14-II．（1）5.000。（5）"},{"type":"math","value":"\\frac{\\sqrt3}{6}D"},{"type":"text","value":"。"},{"type":"text","value":"\n14-III．"},{"type":"text","value":"\n（1）正极。"},{"type":"text","value":"\n（2）接线如图，减小。"},{"type":"figure","src":"images/010b2e30e98096d032087fa597029284753a03dc371147d72b85a75d56843c0a.png","width":351,"height":353,"width_mm":95},{"type":"text","value":"\n（3）减小。"}]}},{"id":"zj-26-erkao--zhenhai-zhongxue-moni-2605-q15","paper_id":"zj-26-erkao--zhenhai-zhongxue-moni-2605","source_question_id":"zhenhai-zhongxue-moni-2605-q15","number":"15","order":15,"type":"计算题","topics":["力学","热学"],"answer_status":"source","fingerprint":"5f71115d612409067d056338806f4ff09ad3713ab9ec5a826dcab7ada19a0d9b","body":[{"type":"text","value":"15. 有人设计了一种测温装置，其结构如图所示。玻璃泡A内封有一定量气体，与A相连的B管插在水银槽中，管内水银面的高度x即可反映泡内气体的温度，即环境温度，并可由B管上的刻度直接读出。设B管的体积与A泡的体积相比可略去不计。\n(1)在标准大气压下对B管进行温度刻度（标准大气压相当于76cm高的水银柱所产生的压强）。当温度 "},{"type":"math","value":"t_1"},{"type":"text","value":" 为 "},{"type":"math","value":"27^{\\circ}\\mathrm{C}"},{"type":"text","value":" 时，管内水银面高度为16cm，此高度即为 "},{"type":"math","value":"2 7 ^ { \\circ } \\mathrm { C }"},{"type":"text","value":" 的刻度线。问t为-3℃的刻度线在x为多少厘米处？\n(2)该测温装置的温度刻度______（选填“均匀”或“不均匀”）。由于大气压要随季节和天气的变化，所以用这种测温装置来测量温度不可避免地会产生误差，若有一次测量时大气压 "},{"type":"math","value":"p_0"},{"type":"text","value":" 比上述大气压 "},{"type":"math","value":"p_0"},{"type":"text","value":" 低，那么此次测出的温度测量值与其实际的真实值相比是______（选填“偏大”或“偏小”）\n(3)已知装置内气体的内能与温度成正比，即 "},{"type":"math","value":"U=kT"},{"type":"text","value":"，比例系数为 "},{"type":"math","value":"k"},{"type":"text","value":" 已知，水银的密度为 "},{"type":"math","value":"\\rho"},{"type":"text","value":"，重力加速度为 "},{"type":"math","value":"g"},{"type":"text","value":"。当气体从温度 "},{"type":"math","value":"T_1"},{"type":"text","value":" 逐渐升高到 "},{"type":"math","value":"T_2"},{"type":"text","value":" 的过程中，B管中水银柱的高度由 "},{"type":"math","value":"x_1"},{"type":"text","value":" 变为 "},{"type":"math","value":"x_2"},{"type":"text","value":"，若要考虑B管内的体积变化，已知B管的横截面积为S，水银的密度为 "},{"type":"math","value":"\\rho"},{"type":"text","value":"，大气压为 "},{"type":"math","value":"p_0"},{"type":"text","value":" ，求该过程中气体所吸收的热量 "},{"type":"math","value":"Q"},{"type":"figure","src":"images/4b6c3e14cb31a264bdd1a2aed2e855d7673a10b5ec74b7963690c7c0e51f39b6.png","width":251,"height":369,"width_mm":29.402,"row_group":"zhenhai-zhongxue-moni-2605-q15-row1"}],"choices":[],"answer":{"status":"source","key":null,"body":[{"type":"text","value":"（1）"},{"type":"math","value":"T_1=t_1+273\\,\\mathrm K"},{"type":"text","value":"。"},{"type":"text","value":"\n解得"},{"type":"math","value":"T_1=300\\,\\mathrm K"},{"type":"text","value":"，"},{"type":"math","value":"T_2=270\\,\\mathrm K"},{"type":"text","value":"。\n"},{"type":"math","value":"p_1=p_0-\\rho gx_1=60\\,\\mathrm{cmHg}"},{"type":"text","value":"。"},{"type":"text","value":"\nV 不变，"},{"type":"math","value":"\\frac{p_1}{T_1}=\\frac{p_2}{T_2}"},{"type":"text","value":"。"},{"type":"text","value":"\n解得"},{"type":"math","value":"p_2=54\\,\\mathrm{cmHg}"},{"type":"text","value":"，所以"},{"type":"math","value":"x_2=22\\,\\mathrm{cm}"},{"type":"text","value":"。"},{"type":"text","value":"\n（2）均匀。偏大（高）。"},{"type":"text","value":"\n（勘误：按本小问等容近似，"},{"type":"math","value":"p/T"},{"type":"text","value":"恒定，而"},{"type":"math","value":"p=p_0-\\rho gx"},{"type":"text","value":"，故温度与液面高度为线性关系。）"},{"type":"text","value":"\n（3）"},{"type":"math","value":"p=p_0-\\rho gx"},{"type":"text","value":"。\n"},{"type":"math","value":"W=-\\bar pS\\Delta x"},{"type":"text","value":"。"},{"type":"text","value":"\n解得"},{"type":"math","value":"W=-p_0S(x_1-x_2)+\\frac12\\rho gS(x_1^2-x_2^2)"},{"type":"text","value":"。"},{"type":"text","value":"\n根据"},{"type":"math","value":"\\Delta U=W+Q"},{"type":"text","value":"。"},{"type":"text","value":"\n解得"},{"type":"math","value":"Q=k(T_2-T_1)+p_0S(x_1-x_2)-\\frac12\\rho gS(x_1^2-x_2^2)"},{"type":"text","value":"。"}]}},{"id":"zj-26-erkao--zhenhai-zhongxue-moni-2605-q16","paper_id":"zj-26-erkao--zhenhai-zhongxue-moni-2605","source_question_id":"zhenhai-zhongxue-moni-2605-q16","number":"16","order":16,"type":"计算题","topics":["力学"],"answer_status":"source","fingerprint":"420307bffe40904d6bccffb8b66e192e660ce59d516aed75fc54fb4d37fd5c88","body":[{"type":"text","value":"16.如图1所示为一款打弹珠游戏装置，斜面与水平面的夹角为 "},{"type":"math","value":"3 0 ^ { \\circ }"},{"type":"text","value":" ，斜面上固定有两块圆形挡板（一块半圆挡板、一块四分之一圆挡板）和四块直挡板。斜面俯视图及尺寸如图2所示，底板沿水平方向，两圆形挡板均与直挡板相切，右侧两直挡板间距略大于弹珠尺寸，左侧两直挡板间形成了一块矩形cdef中奖区间。游戏时，弹珠置于右侧两直挡板间紧贴底板，通过拉动拉杆后释放拉杆，拉杆上的顶杆穿过底板小孔与弹珠在底板处碰撞，弹珠获得动能，若弹珠运动过程进入“取胜区”即可赢得游戏。已知弹珠质量为m且可视为质点，重力加速度大小为g，忽略一切摩擦，求:\n(1)弹珠在斜面上做类平抛运动时的加速度大小 "},{"type":"math","value":"a ;"},{"type":"text","value":"\n(2)要使得弹珠与点b（左侧直挡板与半圆挡板的切点）相撞击，内侧圆形轨道最高点a对弹珠的作用力大小N;\n(3)该游戏若能取胜，弹珠被撞击后的动能需要满足的条件（若存在碰撞，仅考虑与bc区域直挡板的弹性碰撞)。\n"},{"type":"figure","src":"images/67ebd8a743827da8cc5093f6ab528ecb0c99a4402342bb095db705e039cd0b04.png","width":578,"height":496,"width_mm":67.835,"row_group":"zhenhai-zhongxue-moni-2605-q16-row1"},{"type":"text","value":"\n图1\n"},{"type":"figure","src":"images/a7311784635f356e9ea31abdbaeee7979925d56f09a15789fe5ed6aa2622a94e.png","width":353,"height":567,"width_mm":41.373,"row_group":"zhenhai-zhongxue-moni-2605-q16-row1"},{"type":"text","value":"\n图2"}],"choices":[],"answer":{"status":"source","key":null,"body":[{"type":"text","value":"（1）对于弹珠在斜面上的类平抛运动由牛顿第二定律有"},{"type":"math","value":"mg\\sin30^\\circ=ma"},{"type":"text","value":"。"},{"type":"text","value":"\n解得"},{"type":"math","value":"a=\\frac12g"},{"type":"text","value":"。"},{"type":"text","value":"\n（2）设离开 a 点的速度大小为"},{"type":"math","value":"v_{a1}"},{"type":"text","value":"，沿底板方向有"},{"type":"math","value":"R=v_{a1}t_1"},{"type":"text","value":"。"},{"type":"text","value":"\n垂直于底板方向有"},{"type":"math","value":"R=\\frac12at_1^2"},{"type":"text","value":"。"},{"type":"text","value":"\n解得"},{"type":"math","value":"v_{a1}=\\frac{\\sqrt{gR}}2"},{"type":"text","value":"。"},{"type":"text","value":"\n在 a 点，由圆周运动动力学方程有"},{"type":"math","value":"mg\\sin30^\\circ-N=m\\frac{v_{a1}^2}{R}"},{"type":"text","value":"。"},{"type":"text","value":"\n解得"},{"type":"math","value":"N=\\frac14mg"},{"type":"text","value":"。"},{"type":"text","value":"\n（3）由于弹珠与 bc 间的碰撞为弹性碰撞，可将碰撞后的运动轨迹沿着 bc 轴对称折叠，碰撞前后的运动可以合并成类平抛运动。"},{"type":"text","value":"\n现分析弹珠经碰撞后恰好撞击 b 点的情况，设过 a 的速度为"},{"type":"math","value":"v_{a2}"},{"type":"text","value":"，轨迹如下。"},{"type":"figure","src":"images/a9b26e39691873fac5c83ae58996a8a9d1e70f3cc9578110f651d35cd5cbee08.png","width":234,"height":436,"width_mm":95},{"type":"text","value":"\n水平方向有"},{"type":"math","value":"1.5R=v_{a2}t_2"},{"type":"text","value":"。"},{"type":"text","value":"\n垂直于底板方向有"},{"type":"math","value":"2.25R=\\frac12at_2^2"},{"type":"text","value":"。"},{"type":"text","value":"\n解得"},{"type":"math","value":"v_{a2}=v_{a1}=\\frac{\\sqrt{gR}}2"},{"type":"text","value":"。"},{"type":"text","value":"\n对离开圆轨道后类平抛运动恰好过 f 点的情况，设其过 a 的速度为"},{"type":"math","value":"v_{a3}"},{"type":"text","value":"，水平方向有"},{"type":"math","value":"0.5R=v_{a3}t_3"},{"type":"text","value":"。"},{"type":"text","value":"\n垂直于底板方向有"},{"type":"math","value":"2.25R=\\frac12at_3^2"},{"type":"text","value":"。"},{"type":"text","value":"\n联立解得"},{"type":"math","value":"v_{a3}=\\frac{\\sqrt{gR}}6"},{"type":"text","value":"。"},{"type":"text","value":"\n若弹珠过 a 点后恰不脱轨，其刚过 a 点速度满足"},{"type":"math","value":"mg\\sin30^\\circ=m\\frac{v_{a4}^2}{R}"},{"type":"text","value":"。"},{"type":"text","value":"\n弹珠从底板到 a 点的过程，解得"},{"type":"math","value":"v_{a4}=\\sqrt{\\frac{gR}2}"},{"type":"text","value":"。"},{"type":"text","value":"\n弹珠从底板到 a 点的过程，由动能定理可得"},{"type":"math","value":"-(2.25+1)mgR\\sin30^\\circ=\\frac12mv_a^2-E_k"},{"type":"text","value":"。"},{"type":"text","value":"\n因要取胜，过 a 点的速度需满足"},{"type":"math","value":"v_{a3}\\le v_a\\le v_{a1}"},{"type":"text","value":"或"},{"type":"math","value":"v_a\\ge v_{a4}"},{"type":"text","value":"，故解得弹珠被撞击后的动能需要满足的条件\n"},{"type":"math","value":"\\frac{59}{36}mgR\\le E_k\\le\\frac74mgR"},{"type":"text","value":"或"},{"type":"math","value":"E_k\\ge\\frac{15}8mgR"},{"type":"text","value":"。"}]}},{"id":"zj-26