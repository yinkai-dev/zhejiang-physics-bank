}^{2}d\\cdot\\Delta r}{2\\rho}"},{"type":"text","value":"（2 分）\n单位面积上的热功率"},{"type":"math","value":"P_{0} = \\frac{P}{S_{1}} = \\frac{\\pi k^{2}r^{3}I_{0}^{2}d\\cdot\\Delta r}{2\\rho \\times 2\\pi r \\cdot \\Delta r} = \\frac{k^{2}r^{2}I_{0}^{2}d}{4\\rho}"},{"type":"text","value":"（类似其他方法也给分）（1 分）"},{"type":"figure","src":"images/08d6926484ea6b40b39ec555ee460554d19d17e6e9cf7412867859ba3297352b.png","width":151,"height":142,"width_mm":19.1},{"type":"text","value":"由上式得：发热圆盘工作时 r 越大温度越高，即靠近圆心处的温度比外侧低。（1 分）"}]}},{"id":"zj-26-erkao--z20-lianmeng-2605-q17","paper_id":"zj-26-erkao--z20-lianmeng-2605","source_question_id":"z20-lianmeng-2605-q17","number":"17","order":17,"type":"计算题","topics":["力学"],"answer_status":"source","fingerprint":"ffd9003fb64429d894a5090350c8c52ecad020a85702b04841227f128bdd1a8e","body":[{"type":"text","value":"17. （12 分）如图所示是探究不同速度下弹性碰撞的简化装置，倾角为 "},{"type":"math","value":"\\theta"},{"type":"text","value":" 的斜面固定于水平地面，斜面上固定有半径为 "},{"type":"math","value":"R"},{"type":"text","value":" 的半圆挡板、长为 "},{"type":"math","value":"7R"},{"type":"text","value":" 的直挡板和小挡片 "},{"type":"math","value":"e"},{"type":"text","value":" 。 "},{"type":"math","value":"a"},{"type":"text","value":" 为直挡板下端点， "},{"type":"math","value":"bd"},{"type":"text","value":" 为半圆挡板直径且沿水平方向， "},{"type":"math","value":"c"},{"type":"text","value":" 为半圆挡板最高点，两挡板相切于 "},{"type":"math","value":"b"},{"type":"text","value":" 点， "},{"type":"math","value":"de"},{"type":"text","value":" 与 "},{"type":"math","value":"ab"},{"type":"text","value":" 平行且等长，在小挡片 "},{"type":"math","value":"e"},{"type":"text","value":" 上固定原长 "},{"type":"math","value":"3.5R"},{"type":"text","value":" 、劲度系数为 "},{"type":"math","value":"k"},{"type":"text","value":" 的轻质弹簧，小球乙被锁定在 "},{"type":"math","value":"c"},{"type":"text","value":" 点。小球甲从 "},{"type":"math","value":"a"},{"type":"text","value":" 点以一定初速度出发，沿挡板运动到 "},{"type":"math","value":"c"},{"type":"text","value":" 点与小球乙发生完全弹性碰撞，碰撞前瞬间解除对小球乙的锁定，小球乙在此后的运动过程中无其他碰撞。已知：小球甲质量为 "},{"type":"math","value":"m_1 = 1\\mathrm{kg}"},{"type":"text","value":" 、小球乙质量为 "},{"type":"math","value":"m_2"},{"type":"text","value":" （未知）、 "},{"type":"math","value":"R = 0.2\\mathrm{m}"},{"type":"text","value":" 、 "},{"type":"math","value":"\\theta = 30^{\\circ}"},{"type":"text","value":" ，弹簧的劲度系数 "},{"type":"math","value":"k = 60\\mathrm{N/m}"},{"type":"text","value":" ，两小球均可视为质点，不计一切摩擦。\n（1）若小球甲沿挡板恰能运动到 c 点，碰撞后小球乙也沿挡板运动并压缩弹簧，弹簧始终处于弹性限度内。求：\n①小球甲运动到 c 点速度 "},{"type":"math","value":"v_{c}"},{"type":"text","value":" 的大小；\n②若 "},{"type":"math","value":"\\frac{m_1}{m_2} = 1"},{"type":"text","value":" ，小球乙从接触弹簧至最低点的时间 "},{"type":"math","value":"t"},{"type":"text","value":" ；（可用反三角函数表示）\n（2）若小球甲沿挡板恰能运动到 c 点，碰撞后小球乙不沿挡板过 f 点，求：\n① "},{"type":"math","value":"\\frac{m_{1}}{m_{2}}"},{"type":"text","value":" 的比值；\n② 在上述质量比值下，改变小球甲的初速度（仍沿挡板运动），使碰撞后小球乙能越过线段 "},{"type":"math","value":"df"},{"type":"text","value":" （不与挡板和弹簧相碰），小球甲初速度应满足的条件。\n"},{"type":"figure","src":"images/0c5eee061f13b587c73e3b5df7aa0f4d50b80e5ff87a273391aee544d7e41b14.png","width":386,"height":271,"width_mm":45.27,"row_group":"z20-lianmeng-2605-q17-row1"},{"type":"text","value":"\n第 17 题图\n\n可能用到的相关参数：除题目说明外 "},{"type":"math","value":"g"},{"type":"text","value":" 取 "},{"type":"math","value":"10\\mathrm{m/s^2}"},{"type":"text","value":"。\n"}],"choices":[],"answer":{"status":"source","key":null,"body":[{"type":"text","value":"17. （12 分）【详解】\n（1）①甲恰能到 c 点，可知"},{"type":"math","value":"m_{1}g \\sin \\theta = m_{1} \\frac{v_{c}^{2}}{R}"},{"type":"text","value":"（1 分）"},{"type":"math","value":"v_{c}=\\sqrt{gR\\sin\\theta}=1^{m}/s"},{"type":"text","value":"（1 分）\n②甲乙发生完全弹性碰撞，碰撞前后动量和能量守恒得："},{"type":"math","value":"m_{1}v_{c}=m_{1}v_{1}+m_{2}v_{2}"},{"type":"math","value":"\\frac{1}{2}m_{1}v_{c}^{2}=\\frac{1}{2}m_{1}v_{1}^{2}+\\frac{1}{2}m_{2}v_{2}^{2}"},{"type":"text","value":"解得碰后乙的速度为"},{"type":"math","value":"v_{2}=\\frac{2m_{1}v_{c}}{m_{1}+m_{2}}"},{"type":"text","value":"当"},{"type":"math","value":"m_{1}=m_{2}"},{"type":"text","value":"时，"},{"type":"math","value":"v_{2}=\\sqrt{gR\\sin\\theta}=1m/s"},{"type":"text","value":"（或直接写交换速度同样给分）\n从c点至弹簧压缩量最大位置，由能量守恒得"},{"type":"math","value":"m_{1}g(4.5R+\\Delta x)\\sin\\theta+\\frac{1}{2}m_{1}v_{2}^{2}=\\frac{1}{2}k\\cdot\\Delta x^{2}"},{"type":"text","value":"解得："},{"type":"math","value":"\\Delta x=\\frac{5}{2}R=0.5m"},{"type":"text","value":"（1分）\n小球乙速度最大时，弹簧压缩量为"},{"type":"math","value":"\\Delta x_{1}=\\frac{mg\\sin\\theta}{k}=\\frac{1}{12}m"},{"type":"text","value":"所以弹簧振子的振幅"},{"type":"math","value":"A=\\Delta x-\\Delta x_{1}=\\frac{25R}{12}=\\frac{5}{12}m"},{"type":"text","value":"（1分）\n由单位圆得：小球乙从接触弹簧至最低点的时间"},{"type":"math","value":"t = (\\frac{\\pi}{2} + arc\\sin \\frac{1}{5})\\sqrt{\\frac{1}{60}}"},{"type":"text","value":"s或"},{"type":"math","value":"t = (\\pi - arc\\cos \\frac{1}{5})\\sqrt{\\frac{1}{60}}"},{"type":"text","value":"s\n(2 分)\n（2）①碰后乙做类平抛运动，小球乙过f点，有："},{"type":"math","value":"4.5R=\\frac{1}{2}g\\sin\\theta t^{2}"},{"type":"math","value":"R = v _ {2} t"},{"type":"text","value":"解得"},{"type":"math","value":"v_{2}=\\frac{1}{3}\\sqrt{gR\\sin\\theta}"},{"type":"text","value":"(1 分)\n又碰后乙的速度为"},{"type":"math","value":"v_{2} = \\frac{2m_{1}v_{1}}{m_{1} + m_{2}}"},{"type":"text","value":"可得"},{"type":"math","value":"\\frac{m_1}{m_2} = \\frac{1}{5}"},{"type":"text","value":"(1 分)\n②若碰后乙能越过线段"},{"type":"math","value":"df"},{"type":"text","value":"，得碰后乙做类平抛运动\n故碰后乙的速度必然满足"},{"type":"math","value":"v_{2} < \\sqrt{gR\\sin\\theta}"},{"type":"text","value":"同时根据类平抛运动规律可知"},{"type":"math","value":"4.5R = \\frac{1}{2} g\\sin \\theta \\cdot \\Delta t^2, v_2\\Delta t > R"},{"type":"text","value":"(1 分)\n同时需保证小球不能撞击到圆弧 cd 上，可得当"},{"type":"math","value":"R=\\frac{1}{2}g\\sin\\theta\\cdot\\Delta t^{2}"},{"type":"text","value":"，"},{"type":"math","value":"v_{2}\\Delta t<R"},{"type":"text","value":"（1 分）\n联立解得"},{"type":"math","value":"\\frac{1}{3}\\sqrt{gR\\sin\\theta} < v_2 < \\sqrt{\\frac{1}{2} gR\\sin\\theta}"},{"type":"text","value":"将"},{"type":"math","value":"\\frac{m_1}{m_2} = \\frac{1}{5}"},{"type":"text","value":"代入可得"},{"type":"math","value":"\\sqrt{gR\\sin\\theta} < v_1 < \\sqrt{\\frac{9}{2} gR\\sin\\theta}"},{"type":"text","value":"代入数据得"},{"type":"math","value":"1^{\\mathrm{m}} / \\mathrm{s} < v_{1} < \\sqrt{\\frac{9}{2}}\\mathrm{m} / \\mathrm{s}"},{"type":"text","value":"(1 分)\n对甲球从a到c过程中，由动能定理得："},{"type":"math","value":"-m_{1}g\\cdot8R\\sin\\theta=\\frac{1}{2}m_{1}v_{1}^{2}-\\frac{1}{2}m_{1}v_{0}^{2}"},{"type":"math","value":"v_{0}=\\sqrt{v_{1}^{2}+16gR\\sin\\theta}"},{"type":"text","value":"得：小球甲初速度应满足的条件"},{"type":"math","value":"\\sqrt{17}\\mathrm{m / s} < v_0 < \\sqrt{\\frac{41}{2}}\\mathrm{m / s}"},{"type":"text","value":"(1 分)"}]}},{"id":"zj-26-erkao--z20-lianmeng-2605-q18","paper_id":"zj-26-erkao--z20-lianmeng-2605","source_question_id":"z20-lianmeng-2605-q18","number":"18","order":18,"type":"计算题","topics":["电学","力学"],"answer_status":"source","fingerprint":"3757f3786538c24a51e69fe16ee469c9a91c9d5af522a1491743256db303bd68","body":[{"type":"text","value":"18.（13分）中性粒子分析器是核聚变研究中的重要设备，通过对高能中性原子能量或动量的测量，可诊断曾与这些中性原子充分碰撞过的离子的性质。如图甲所示，为了测量某中性原子碰撞后的动能，首先让质量为 "},{"type":"math","value":"M"},{"type":"text","value":" 的中性原子电离成 "},{"type":"math","value":"+q"},{"type":"text","value":" 的离子，经孔 "},{"type":"math","value":"A"},{"type":"text","value":" 与下边界成 "},{"type":"math","value":"\\theta = 30^{\\circ}"},{"type":"text","value":" 角入射到间距为 "},{"type":"math","value":"d"},{"type":"text","value":" 的平行有界偏转区域（充满匀强电场或磁场），经偏转后离开区域，再沿直线打到位于 "},{"type":"math","value":"x"},{"type":"text","value":" 轴上的接收板被收集， "},{"type":"math","value":"x"},{"type":"text","value":" 轴与下边界平行且距下边界 "},{"type":"math","value":"h"},{"type":"text","value":" ，原点 "},{"type":"math","value":"O"},{"type":"text","value":" 位于 "},{"type":"math","value":"A"},{"type":"text","value":" 点正下方。不计离子的重力及相互作用，不考虑相对论效应及场的边界效应。\n（1）若偏转区域内充满垂直边界且方向向下的匀强电场，上下边界间电压为 "},{"type":"math","value":"U"},{"type":"text","value":" ，离子恰好打到接收板的 "},{"type":"math","value":"x_0"},{"type":"text","value":" 坐标，求该离子的动能 "},{"type":"math","value":"E_0"},{"type":"text","value":" 和 "},{"type":"math","value":"x_0"},{"type":"text","value":" 之间的关系；\n（2）若偏转区域内充满磁感应强度为 "},{"type":"math","value":"B"},{"type":"text","value":" 且方向垂直纸面向外的匀强磁场，离子仍打到接收板的 "},{"type":"math","value":"x_0"},{"type":"text","value":" 坐标，求该离子的动能 "},{"type":"math","value":"E_{1}"},{"type":"text","value":" 和 "},{"type":"math","value":"x_0"},{"type":"text","value":" 之间的关系；\n（3）在第（2）中，被测离子束射入磁场中时一般具有发散角 "},{"type":"math","value":"\\Delta \\alpha (\\Delta \\alpha \\ll \\theta)"},{"type":"text","value":" ，为了提高测量的精度，要求具有相同动能的离子打到接收板的同一位置，求 "},{"type":"math","value":"h"},{"type":"text","value":" 与动能 "},{"type":"math","value":"E"},{"type":"text","value":" 的关系；（当 "},{"type":"math","value":"x"},{"type":"text","value":" 很小时，有 "},{"type":"math","value":"\\sin x\\approx x"},{"type":"text","value":" ， "},{"type":"math","value":"\\cos x\\approx 1"},{"type":"text","value":" ， "},{"type":"math","value":"\\cot (\\theta +x)\\approx \\cot \\theta -\\frac{x}{\\sin^2\\theta}"},{"type":"text","value":"）\n（4）若中性原子的动能是由质量为 m 的入射离子散射（弹性碰撞）获得，如图乙所示。已知入射离子的散射角为 "},{"type":"math","value":"\\alpha"},{"type":"text","value":" ，忽略中性原子的初动能，碰撞后入射离子动能为碰撞前的 k 倍，求出 k 可能的表达式（用 "},{"type":"math","value":"\\alpha"},{"type":"text","value":" ，m，M 表示；离子和原子视作质点）。\n"},{"type":"figure","src":"images/44fbc63478325b18a6467015885b1365e603e7226994a8328a1bc741897754e1.png","width":995,"height":328,"width_mm":116.855,"row_group":"z20-lianmeng-2605-q18-row1"},{"type":"text","value":"\n第18题图"}],"choices":[],"answer":{"status":"source","key":null,"body":[{"type":"text","value":"18. （13 分）【详解】\n（1）离子在偏转电场中运动的时间"},{"type":"math","value":"t = \\frac{2v\\sin\\theta}{a}"},{"type":"text","value":"（1分）\n离子在偏转电场中平行于下边界的位移"},{"type":"math","value":"x = v \\cos \\theta \\cdot \\frac {2 v \\sin \\theta}{a} = \\frac {4 d E _ {\\mathrm{k}} \\sin \\theta \\cos \\theta}{U q}"},{"type":"text","value":"（1 分）"},{"type":"math","value":"x = x _ {0} - \\frac {h}{\\tan \\theta}"},{"type":"text","value":"（1 分）\n代入得"},{"type":"math","value":"E_0 = \\frac{\\sqrt{3} Uq(x_0 - \\sqrt{3} h)}{3d}"},{"type":"text","value":"(1 分)\n（2）在磁场中，离子在磁场中做圆周运动，根据向心力公式"},{"type":"math","value":"B q v = M \\frac {v ^ {2}}{r}, \\text{联立可得：} r = \\frac {\\sqrt {2 M E _ {1}}}{B q}"},{"type":"text","value":"（1 分）"},{"type":"math","value":"\\text{根据几何关系}; l = 2 r \\sin \\theta + h \\cot \\theta"},{"type":"text","value":"（1 分）\n可得："},{"type":"math","value":"E_{1}=\\frac{B^{2}q^{2}(x_{0}-\\sqrt{3}h)^{2}}{2M}"},{"type":"text","value":"(1分)\n（3）若满足"},{"type":"math","value":"l = 2 r \\sin \\theta + h \\cot \\theta = 2 r \\sin (\\theta \\mp \\Delta \\alpha) + h \\cot (\\theta \\mp \\Delta \\alpha)"},{"type":"text","value":"（1 分）\n即可满足要求。由于："},{"type":"math","value":"\\sin(\\theta\\mp\\Delta\\alpha)=\\sin\\theta\\cos\\Delta\\alpha\\mp\\sin\\Delta\\alpha\\cos\\theta\\simeq\\sin\\theta\\mp\\Delta\\alpha\\cos\\theta"},{"type":"text","value":"联立可得："},{"type":"math","value":"h=2r\\cos\\theta\\sin^{2}\\theta=\\frac{\\sqrt{6mE}}{4Bq}"},{"type":"text","value":"（2分）\n（4）质量为 m 的离子与质量为 M 的静止原子发生了弹性碰撞，动量守恒、机械能守恒，有"},{"type":"math","value":"m\\Delta v = Mv_{2}"},{"type":"math","value":"\\frac{1}{2}mv_{0}^{2}=\\frac{1}{2}mv_{1}^{2}+\\frac{1}{2}Mv_{2}^{2}"},{"type":"text","value":"(1分)\n根据余弦定理"},{"type":"math","value":"\\cos \\alpha = \\frac{v_0^2 + v_1^2 - \\Delta v^2}{2v_0v_1}"},{"type":"text","value":"得"},{"type":"math","value":"\\Delta v = \\sqrt{v_0^2 + v_1^2 - 2v_0v_1\\cos\\alpha}"},{"type":"text","value":"（1分）\n则有"},{"type":"math","value":"v_{2}=\\frac{m\\Delta v}{M}=\\frac{m}{M}\\sqrt{v_{0}^{2}+v_{1}^{2}-2v_{0}v_{1}\\cos\\alpha}"},{"type":"text","value":"可解得"},{"type":"math","value":"K = \\frac{\\frac{1}{2}mv_1^2}{\\frac{1}{2}mv_0^2} = \\left(\\frac{\\cos\\alpha\\pm\\sqrt{\\left(\\frac{M}{m}\\right)^2 - \\sin^2\\alpha}}{1 + \\frac{M}{m}}\\right)^2"},{"type":"text","value":"(1 分)"}]}}]}
