e":"53^{\\circ}"},{"type":"text","value":"角时，"},{"type":"math","value":"v_{2}'=\\frac{3}{4}v_{0}\\sin37^{\\circ}=\\frac{9}{20}v_{0}"},{"type":"text","value":"1分\n沿"},{"type":"math","value":"v_{2}"},{"type":"text","value":"方向速度变化量为"},{"type":"math","value":"\\Delta v_{2}=\\frac{9}{20}v_{0}-\\frac{5}{4}v_{0}=-\\frac{4}{5}v_{0}"},{"type":"text","value":"沿"},{"type":"math","value":"v_{2}"},{"type":"text","value":"方向利用动量定理："},{"type":"math","value":"-\\sum kv_{2}\\Delta t=4m\\Delta v_{2}"},{"type":"text","value":"可得"},{"type":"math","value":"S_{2}=\\sum v_{2}\\Delta t=\\frac{16mv_{0}}{5k}"},{"type":"text","value":"其沿x轴正方向走过的位移为"},{"type":"math","value":"S_{2x}=S_{2}\\cos37^{\\circ}=\\frac{64mv_{0}}{25k}"},{"type":"text","value":"1分"}]}}]}
